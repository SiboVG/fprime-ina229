{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Static analysis (cppcheck + clang-tidy)",
            "type": "shell",
            "command": "python3 scripts/static_analysis.py",
            "group": "test",
            "problemMatcher": {
                "owner": "static-analysis",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|style|performance|portability): (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}
